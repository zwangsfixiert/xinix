[Unit]
Description=Deep Trades – API (FastAPI/uvicorn)
After=network-online.target deeptrades-collector.service
Wants=network-online.target

[Service]
Type=simple
User=deeptrades
Group=deeptrades
WorkingDirectory=/opt/deeptrades
Environment=DEEPTRADES_CONFIG=/opt/deeptrades/config.toml
ExecStart=/opt/deeptrades/.venv/bin/python -m deeptrades.api --config /opt/deeptrades/config.toml
Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# read-only DB access; WAL readers still need the -shm file to be writable
ReadWritePaths=/opt/deeptrades/data

[Install]
WantedBy=multi-user.target
